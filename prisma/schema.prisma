// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  password      String
  username      String
  profileUrl    String
  authProvider  AuthProvider? @default(solo)
  role          String?       @default("blogger")
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  refreshToken refresh_token?
  otps          otp[]
  blogs blogs[]
  token token?
}

enum AuthProvider {
  google
  solo
}

model refresh_token {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  token     String
  updatedAt DateTime @updatedAt

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model otp {
  id           String       @id @default(uuid()) @db.Uuid
  code         String
  userId       String       @db.Uuid
  passwordType PasswordType
  isUsed       Boolean      @default(false)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, passwordType])
  @@index([userId])
}

enum PasswordType {
  email
  password
}

model token {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  token String
  isUsed Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model blogs{
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  title String
  content String
  slug String @unique
  coverImageUrl String?
  status blogStatus @default(published)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogger users @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes likes[]
  comments comments[]
}

enum blogStatus{
  published
  unpublished
  deleted
}

model likes{
  id String @id @default(uuid()) @db.Uuid
  blogId String @db.Uuid
  likerId String @db.Uuid
  createdAt DateTime @default(now())

  blog blogs @relation(fields: [blogId], references: [id], onDelete: Cascade)
  @@unique([blogId, likerId])
}

model comments{
  id String @id @default(uuid()) @db.Uuid
  blogId String @db.Uuid
  anonId String @db.Uuid
  username String @default("anonymous")
  content String
  createdAt DateTime @default(now())
  replies replies[]

  blog blogs @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model replies{
  id String @id @default(uuid()) @db.Uuid
  commentId String @db.Uuid
  anonId String @db.Uuid
  username String @default("anonymous")
  content String
  createdAt DateTime @default(now())

  comment comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
}